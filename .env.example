# =========================================================
# ATARI STORE PRO X - ENVIRONMENT VARIABLES CONFIGURATION
# =========================================================

# 1. Google Gemini API Key (مفتاح الذكاء الاصطناعي للتشخيص)
# اختياري: يُستخدم لخدمات التشخيص الذكي لأعطال البلايستيشن والكونسول بالصور والفيديو.
# إذا لم يتوفر المفتاح، سيعمل النظام تلقائياً بالمكتبة المحلية الشاملة.
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Application Base URL (رابط التطبيق)
# رابط النشر الخاص بالتطبيق (مثال: https://your-app.vercel.app أو https://yourdomain.com)
APP_URL=http://localhost:3000

# 3. Environment & Port (بيئة التشغيل والمنفذ)
NODE_ENV=production
PORT=3000

# 4. Supabase Credentials (قاعدة البيانات السحابية)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key_here
